{
    "name": "wcostaprijo/pagbank-php",
    "description": "Biblioteca PHP para integração com a API PagBank.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wanderson Costa Aprijo",
            "email": "contact.wcdevelopment@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*",
        "ext-bcmath": "*",
        "nesbot/carbon": "^3.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PagBank\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PagBank\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}